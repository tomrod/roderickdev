---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found -- Roderick.Dev">
  <div class="content-pad">
    <p class="code">404</p>
    <h1 class="heading">Page not found</h1>
    <p class="body">This page doesn't exist or has moved.</p>
    <a href="/">Go home</a>
  </div>
</Base>

<style>
.code {
  font-family: var(--mono);
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  color: var(--muted);
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.heading {
  font-family: var(--serif);
  font-size: 2rem;
  font-weight: 400;
  color: var(--text);
  margin-bottom: 1rem;
}
.body {
  font-family: var(--sans);
  font-size: 0.9rem;
  color: var(--muted);
  margin-bottom: 2rem;
}
</style>
